# ==============================================================================
# Utilvo EdgeShield v1.1.0 — Apache 2.4 / LiteSpeed / cPanel (.htaccess)
# Interactive Rule Customizer: https://utilvo.com/edge-shield
# Native Apache 2.4 Server Config: https://utilvo.com/edge-shield/apache-bot-shield.conf
# Live CIDR Feed: https://utilvo.com/api/edge-shield/threats?format=cidr
# ==============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Whitelist Verified Search Engine Crawlers (SEO Safe-Harbor)
  RewriteCond %{HTTP_USER_AGENT} !(Googlebot|bingbot|Applebot|DuckDuckBot|YandexBot) [NC]

  # 2. Block Spoofed iOS 13.2.3 Emulator & Headless AI Scrapers
  RewriteCond %{HTTP_USER_AGENT} (CPU\ iPhone\ OS\ 13_2_3|HeadlessChrome|Bytespider|PetalBot|TokenFoundryBot|QlyzeBot|ClaudeBot|CCBot|GPTBot) [NC,OR]

  # 3. Block Rotating Cloud Scraper Subnets (AS132203 Tencent / AS45102 Alibaba / AS136907 Huawei)
  RewriteCond %{HTTP:CF-Connecting-IP} ^(43\.(119|12[89]|1[3-6][0-9]|17[0-5])|47\.(74|8[289])|101\.3[23]|159\.138|149\.232)\. [OR]
  RewriteCond %{REMOTE_ADDR} ^(43\.(119|12[89]|1[3-6][0-9]|17[0-5])|47\.(74|8[289])|101\.3[23]|159\.138|149\.232)\.

  RewriteRule .* - [F,L]
</IfModule>
